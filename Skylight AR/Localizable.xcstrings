    "Best after midnight under a dark sky, away from city light.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am besten nach Mitternacht unter dunklem Himmel, fern von Stadtlicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejor después de medianoche bajo un cielo oscuro, lejos de las luces de la ciudad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À observer de préférence après minuit, sous un ciel noir, loin des lumières de la ville."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al meglio dopo mezzanotte sotto un cielo buio, lontano dalle luci della città."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "街明かりから離れた暗い空で、0時過ぎが見頃です。"
          }
        }
      }
    },
    "Best outdoors under open sky. The compass gets pulled off inside airports and buildings, so the sky can sit rotated there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am besten draußen unter freiem Himmel. In Flughäfen und Gebäuden wird der Kompass abgelenkt — dort kann der Himmel verdreht erscheinen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona mejor al aire libre, a cielo abierto. La brújula se desvía dentro de aeropuertos y edificios, así que allí el cielo puede verse girado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne mieux dehors, à ciel ouvert. La boussole est perturbée dans les aéroports et les bâtiments, où le ciel peut apparaître pivoté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona al meglio all'aperto, sotto il cielo. Dentro aeroporti ed edifici la bussola viene deviata, e lì il cielo può risultare ruotato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開けた屋外での使用が最適です。空港や建物の中ではコンパスが乱れやすく、空全体が回転してずれることがあります。"
          }
        }
      }
    },
    "Best under open sky": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am besten unter freiem Himmel"
          }
        },
        "es": {
