    "Major airports within 150 nautical miles are pinned at their true bearing with their IATA code. Tap one in the sky for details.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Große Flughäfen im Umkreis von 150 Seemeilen sind mit ihrem IATA-Code an ihrer wahren Peilung markiert. Tippe einen am Himmel an, um Details zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los aeropuertos principales a menos de 150 millas náuticas se fijan en su rumbo real con su código IATA. Toca uno en el cielo para ver detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les grands aéroports à moins de 150 milles nautiques sont épinglés à leur relèvement réel avec leur code IATA. Touchez-en un dans le ciel pour les détails."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I principali aeroporti entro 150 miglia nautiche sono fissati al loro rilevamento reale con il codice IATA. Toccane uno nel cielo per i dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "150海里以内の主要空港が、実際の方位にIATAコードとともにピン表示されます。空の中でタップすると詳細が見られます。"
          }
        }
      }
    },
    "Manual nudge if it's still a touch off after calibrating.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuelle Feinkorrektur, falls es nach dem Kalibrieren noch leicht daneben liegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste manual si aún queda un poco desviado tras calibrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustement manuel s’il reste un léger décalage après l’étalonnage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ritocco manuale se dopo la calibrazione è ancora un filo fuori."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調整してもまだわずかにずれるときの手動補正です。"
          }
        }
      }
    },
