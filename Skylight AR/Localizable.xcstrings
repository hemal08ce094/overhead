    "Positions come from public data and your compass, so treat it as a guide, not gospel.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Positionen stammen aus öffentlichen Daten und deinem Kompass — nimm sie als Orientierung, nicht als absolute Wahrheit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las posiciones vienen de datos públicos y de tu brújula: tómalo como una guía, no como una verdad absoluta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les positions viennent de données publiques et de votre boussole : voyez-y un guide, pas une vérité absolue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le posizioni vengono da dati pubblici e dalla tua bussola: prendile come una guida, non come oro colato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置は公開データとコンパスに基づくため、絶対視せず目安としてお使いください。"
          }
        }
      }
    },
