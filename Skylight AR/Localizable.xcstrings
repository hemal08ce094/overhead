    "Get a token at fr24api.flightradar24.com — free sandbox, or the $9/mo Explorer plan. Leave empty to use the free airplanes.live feed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hol dir einen Token auf fr24api.flightradar24.com — kostenlose Sandbox oder der Explorer-Tarif für 9 $/Monat. Leer lassen, um den kostenlosen airplanes.live-Feed zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigue un token en fr24api.flightradar24.com — sandbox gratuito o el plan Explorer de 9 $/mes. Déjalo vacío para usar la fuente gratuita de airplanes.live."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez un jeton sur fr24api.flightradar24.com — bac à sable gratuit, ou formule Explorer à 9 $/mois. Laissez vide pour utiliser le flux gratuit airplanes.live."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendi un token su fr24api.flightradar24.com — sandbox gratuita o piano Explorer da 9 $ al mese. Lascia vuoto per usare il feed gratuito di airplanes.live."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークンはfr24api.flightradar24.comで取得できます — 無料のサンドボックス、または月額9ドルのExplorerプランです。空欄のままにすると無料のairplanes.liveフィードを使用します。"
          }
        }
      }
    },
