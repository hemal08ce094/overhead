    },
    "A tail number follows one specific airframe wherever it flies.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kennzeichen folgt einer bestimmten Maschine, wohin sie auch fliegt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una matrícula sigue a un avión concreto allá donde vuele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une immatriculation suit un appareil précis partout où il vole."
