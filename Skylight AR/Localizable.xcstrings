    "Rises %@ and climbs to %lld° — open Overhead to watch it cross.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgang %1$@, steigt bis %2$lld° — öffne Overhead und sieh beim Überflug zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Rises %1$@ and climbs to %2$lld° — open Overhead to watch it cross."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale %1$@ y sube hasta %2$lld° — abre Overhead para verla cruzar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lève %1$@ et monte à %2$lld° — ouvrez Overhead pour suivre le passage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorge %1$@ e sale fino a %2$lld° — apri Overhead per vederla passare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@に昇り、最大%2$lld°まで上がります — Overheadを開いて通過を見届けましょう。"
          }
        }
      }
    },
    "Rises near sunset and stays up all night. %@ is the traditional name for %@'s full moon.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geht um Sonnenuntergang auf und bleibt die ganze Nacht am Himmel. %1$@ ist der traditionelle Name für den Vollmond im %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Rises near sunset and stays up all night. %1$@ is the traditional name for %2$@'s full moon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sale cerca del atardecer y permanece toda la noche. %1$@ es el nombre tradicional de la luna llena de %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se lève vers le coucher du soleil et reste visible toute la nuit. %1$@ est le nom traditionnel de la pleine lune de %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorge verso il tramonto e resta in cielo tutta la notte. %1$@ è il nome tradizionale della luna piena di %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日没のころに昇り、一晩中空にあります。%1$@は%2$@の満月の伝統的な呼び名です。"
          }
        }
      }
    },
