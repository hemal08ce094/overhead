    "Maximum at this exact spot. Never look at the sun without proper eclipse glasses.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum genau an diesem Ort. Schau nie ohne geeignete Finsternisbrille in die Sonne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Máximo en este punto exacto. Nunca mires al sol sin gafas de eclipse homologadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum à cet endroit précis. Ne regardez jamais le soleil sans lunettes d’éclipse adaptées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il massimo in questo punto esatto. Non guardare mai il sole senza occhiali da eclissi adeguati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まさにこの場所での最大食です。日食グラスなしで太陽を見ないでください。"
