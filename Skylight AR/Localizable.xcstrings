          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une recherche mondiale exige l’immatriculation complète — p. ex. %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per una ricerca globale serve la matricola completa — es. %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界検索には完全な機体記号が必要です — 例：%@。"
          }
        }
      }
    },
    "A living reference — not a precision instrument.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein lebendiges Nachschlagewerk — kein Präzisionsinstrument."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una referencia viva — no un instrumento de precisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une référence vivante — pas un instrument de précision."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un riferimento vivo — non uno strumento di precisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生きた参考資料であり、精密機器ではありません。"
          }
        }
      }
    },
    "A nudge 10 minutes before it rises": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Stups 10 Minuten vor dem Aufgang"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso 10 minutos antes de que salga"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel 10 minutes avant son lever"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un avviso 10 minuti prima che sorga"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昇る10分前にそっとお知らせ"
          }
        }
      }
    },
    "A plane's color is its altitude — warm orange down low, shifting to cyan up at cruise.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Farbe eines Flugzeugs zeigt seine Höhe — warmes Orange tief unten, Cyan oben auf Reiseflughöhe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El color de un avión es su altitud: naranja cálido abajo, virando a cian en crucero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La couleur d’un avion indique son altitude — orange chaud près du sol, virant au cyan en croisière."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il colore di un aereo è la sua quota — arancione caldo in basso, fino al ciano in crociera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機体の色は高度を表します — 低空では温かなオレンジ、巡航高度ではシアンへ変わります。"
          }
        }
      }
    },
    "A soft river of distant starlight": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein sanfter Strom fernen Sternenlichts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un suave río de luz de estrellas lejanas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un doux fleuve de lumière stellaire lointaine"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fiume soffuso di luce di stelle lontane"
