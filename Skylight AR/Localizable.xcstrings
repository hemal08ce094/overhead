    "If a plane sits a little off, tap it — or the Sun — to snap north back into place.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzt ein Flugzeug etwas daneben, tippe darauf — oder auf die Sonne —, um Norden wieder einrasten zu lassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un avión queda un poco desplazado, tócalo — o al Sol — para reajustar el norte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un avion est un peu décalé, touchez-le — ou le Soleil — pour recaler le nord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se un aereo è un po' fuori posto, toccalo — o tocca il Sole — per rimettere il nord al suo posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "飛行機が少しずれて見えるときは、その機体か太陽をタップすると北がぴたりと合い直します。"
          }
        }
      }
    },
