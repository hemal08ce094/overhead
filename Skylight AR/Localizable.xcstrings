    "Squawk codes are what pilots dial for ATC — 7700 is a declared emergency.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Squawk-Codes stellen Piloten für die Flugsicherung ein — 7700 ist ein erklärter Notfall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los códigos squawk son los que los pilotos marcan para el control aéreo — 7700 es una emergencia declarada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les codes squawk sont ceux que les pilotes affichent pour le contrôle aérien — 7700 est une urgence déclarée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I codici squawk sono quelli che i piloti impostano per il controllo del traffico aereo — 7700 è un'emergenza dichiarata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スコークはパイロットが管制向けに設定するコードです — 7700は緊急事態の宣言です。"
          }
        }
      }
    },
    "Squawking %@ — %@. This aircraft has declared an emergency.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Squawk %1$@ — %2$@. Dieses Flugzeug hat einen Notfall erklärt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Squawking %1$@ — %2$@. This aircraft has declared an emergency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Squawk %1$@ — %2$@. Esta aeronave ha declarado una emergencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Squawk %1$@ — %2$@. Cet appareil a déclaré une urgence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Squawk %1$@ — %2$@. Questo aereo ha dichiarato un'emergenza."
