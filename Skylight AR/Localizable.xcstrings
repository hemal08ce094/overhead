    "Community ADS-B — excellent over the US and Europe, but sparse over the Gulf, the Middle East, and oceans. Free and non-commercial.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Community-ADS-B — hervorragend über den USA und Europa, aber dünn über dem Golf, dem Nahen Osten und den Ozeanen. Kostenlos und nicht kommerziell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ADS-B comunitario — excelente sobre EE. UU. y Europa, pero escaso sobre el Golfo, Oriente Medio y los océanos. Gratuito y no comercial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ADS-B communautaire — excellent au-dessus des États-Unis et de l’Europe, mais clairsemé au-dessus du Golfe, du Moyen-Orient et des océans. Gratuit et non commercial."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ADS-B della community — eccellente su Stati Uniti ed Europa, ma scarso su Golfo, Medio Oriente e oceani. Gratuito e non commerciale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コミュニティ運営のADS-Bです。米国と欧州では非常に充実していますが、湾岸諸国・中東・海洋上ではまばらです。無料・非商用です。"
          }
        }
      }
    },
