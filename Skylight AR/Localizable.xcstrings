            "value": "空の下の、あなたの場所"
          }
        }
      }
    },
    "Your sky is quiet right now — no aircraft within forty nautical miles.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Himmel ist gerade still — kein Flugzeug im Umkreis von vierzig Seemeilen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cielo está tranquilo ahora mismo — ningún avión en cuarenta millas náuticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ciel est calme en ce moment — aucun avion à moins de quarante milles nautiques."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo cielo è tranquillo al momento — nessun aereo entro quaranta miglia nautiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまあなたの空は静かです — 40海里以内に航空機はいません。"
          }
        }
      }
    },
