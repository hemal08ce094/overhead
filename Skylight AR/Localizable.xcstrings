    "Drag the sky left or right until a plane sits exactly where you see it in the air, then tap Done.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe den Himmel nach links oder rechts, bis ein Flugzeug genau dort sitzt, wo du es am Himmel siehst, und tippe dann auf „Fertig“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el cielo a izquierda o derecha hasta que un avión quede exactamente donde lo ves en el aire, y toca Hecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser le ciel vers la gauche ou la droite jusqu’à ce qu’un avion soit exactement là où vous le voyez, puis touchez OK."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina il cielo a destra o a sinistra finché un aereo non è esattamente dove lo vedi in aria, poi tocca Fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際に見えている位置に飛行機がぴたりと重なるまで空を左右にドラッグし、「完了」をタップしてください。"
          }
        }
      }
    },
