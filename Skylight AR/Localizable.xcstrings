          }
        }
      }
    },
    "Uses the LiDAR scanner to keep the sky steady when the camera can't see much — a blank or night sky. Pro models only; toggle to compare." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa el escáner LiDAR para mantener el cielo estable cuando la cámara ve poco — un cielo vacío o nocturno. Solo modelos Pro; actívalo y desactívalo para comparar."
          }
        }
