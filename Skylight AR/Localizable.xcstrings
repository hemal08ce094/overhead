    "Earth's shadow takes a dark bite out of the full moon. Perfectly safe to watch with bare eyes; binoculars make the shadow's edge crisp.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Erdschatten beißt ein dunkles Stück aus dem Vollmond. Völlig ungefährlich mit bloßem Auge; ein Fernglas macht die Schattenkante gestochen scharf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sombra de la Tierra le da un mordisco oscuro a la luna llena. Totalmente seguro a simple vista; unos binoculares hacen nítido el borde de la sombra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ombre de la Terre croque un morceau sombre de la pleine lune. Parfaitement sûr à observer à l’œil nu ; des jumelles rendent le bord de l’ombre plus net."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ombra della Terra dà un morso scuro alla luna piena. Del tutto sicura da guardare a occhio nudo; con un binocolo il bordo dell'ombra diventa nitido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地球の影が満月を暗くかじり取ります。肉眼で見てもまったく安全です。双眼鏡を使うと影の縁がくっきり見えます。"
          }
        }
      }
    },
    "Eclipses and conjunctions are computed for your exact location.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finsternisse und Konjunktionen werden für deinen exakten Standort berechnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los eclipses y conjunciones se calculan para tu ubicación exacta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éclipses et conjonctions sont calculées pour votre position exacte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eclissi e congiunzioni sono calcolate per la tua posizione esatta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日食・月食や惑星の接近は、あなたの正確な位置に合わせて計算されます。"
          }
        }
      }
    },
