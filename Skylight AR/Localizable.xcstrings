    },
    "Every flight counts": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vuelo cuenta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque vol compte"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Flug zählt"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni volo conta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのフライトが数えられる"
          }
        }
      }
    },
    "Each plane you spot climbs you through twelve tiers, every one struck as a medal. Find your standing in Profile.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada avión que avistas te hace subir por doce rangos, cada uno acuñado como una medalla. Consulta tu posición en Perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque avion repéré vous fait gravir douze rangs, chacun frappé comme une médaille. Retrouvez votre position dans Profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes gesichtete Flugzeug bringt dich durch zwölf Ränge, jeder als Medaille geprägt. Deinen Stand findest du im Profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni aereo che avvisti ti fa salire attraverso dodici livelli, ognuno coniato come una medaglia. Trova la tua posizione nel Profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "飛行機を見つけるたびに12のティアを昇格。各ティアはメダルとして刻印されます。プロフィールで確認できます。"
          }
        }
      }
    },
