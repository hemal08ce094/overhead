    "Aim the center of your screen right at the Moon, then tap Lock. Or drag the sky to slide a plane onto its real position, and tap Done.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte die Mitte deines Bildschirms genau auf den Mond und tippe auf „Fixieren“. Oder ziehe den Himmel, bis ein Flugzeug auf seiner echten Position sitzt, und tippe auf „Fertig“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta el centro de la pantalla justo a la Luna y toca Fijar. O arrastra el cielo hasta poner un avión sobre su posición real y toca Hecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visez la Lune avec le centre de l’écran, puis touchez Verrouiller. Ou faites glisser le ciel pour amener un avion sur sa position réelle, puis touchez OK."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punta il centro dello schermo dritto sulla Luna, poi tocca Blocca. Oppure trascina il cielo per portare un aereo sulla sua posizione reale e tocca Fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の中心を月にぴたりと向けて「ロック」をタップしてください。または空をドラッグして飛行機を実際の位置に重ね、「完了」をタップします。"
          }
        }
      }
    },
    "Aim the center of your screen right at the Sun, then tap Lock. Or drag the sky to slide a plane onto its real position, and tap Done.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte die Mitte deines Bildschirms genau auf die Sonne und tippe auf „Fixieren“. Oder ziehe den Himmel, bis ein Flugzeug auf seiner echten Position sitzt, und tippe auf „Fertig“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta el centro de la pantalla justo al Sol y toca Fijar. O arrastra el cielo hasta poner un avión sobre su posición real y toca Hecho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visez le Soleil avec le centre de l’écran, puis touchez Verrouiller. Ou faites glisser le ciel pour amener un avion sur sa position réelle, puis touchez OK."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punta il centro dello schermo dritto sul Sole, poi tocca Blocca. Oppure trascina il cielo per portare un aereo sulla sua posizione reale e tocca Fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の中心を太陽にぴたりと向けて「ロック」をタップしてください。または空をドラッグして飛行機を実際の位置に重ね、「完了」をタップします。"
          }
        }
      }
    },
