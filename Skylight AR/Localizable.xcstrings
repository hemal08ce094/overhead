    "Satellite-backed global coverage, including the Gulf and oceans. Billed per call, so the app polls gently (about every 8 seconds).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Satellitengestützte weltweite Abdeckung, auch über dem Golf und den Ozeanen. Abgerechnet wird pro Abruf — die App fragt daher sparsam ab (etwa alle 8 Sekunden)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobertura global con respaldo satelital, incluidos el Golfo y los océanos. Se factura por consulta, así que la app consulta con calma (cada 8 segundos aproximadamente)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couverture mondiale appuyée par satellite, y compris le Golfe et les océans. Facturée à la requête, donc l’app interroge en douceur (environ toutes les 8 secondes)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copertura globale con supporto satellitare, Golfo e oceani inclusi. Fatturata a chiamata, quindi l'app interroga con delicatezza (circa ogni 8 secondi)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "衛星による全世界カバレッジで、湾岸や海洋上も含みます。呼び出しごとに課金されるため、アプリは控えめに（約8秒ごと）取得します。"
          }
        }
      }
    },
