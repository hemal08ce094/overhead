    "The sky follows the compass and self-corrects as you pan.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Himmel folgt dem Kompass und korrigiert sich beim Schwenken selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cielo sigue la brújula y se corrige solo mientras giras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ciel suit la boussole et se corrige de lui-même pendant que vous balayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cielo segue la bussola e si corregge da solo mentre ti guardi intorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空はコンパスに追従し、動かすうちに自動で補正されます。"
          }
        }
      }
    },
    "The sky right now": {
      "localizations": {
        "de": {
