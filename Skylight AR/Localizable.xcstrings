    "Rises %@ and climbs to %lld° — open Overhead to watch it cross." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Rises %1$@ and climbs to %2$lld° — open Overhead to watch it cross."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sale %1$@ y sube hasta %2$lld° — abre Overhead para verla cruzar."
          }
        }
      }
    },
    "Rises near sunset and stays up all night. %@ is the traditional name for %@'s full moon." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Rises near sunset and stays up all night. %1$@ is the traditional name for %2$@'s full moon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sale cerca del atardecer y permanece toda la noche. %1$@ es el nombre tradicional de la luna llena de %2$@."
          }
        }
      }
    },
    "Rotorhead" : {
