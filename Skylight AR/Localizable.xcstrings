            "value": "仕組み・プライバシー・フィードバック"
          }
        }
      }
    },
    "Hunter's Moon": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jägermond"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna del Cazador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lune du Chasseur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna del Cacciatore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンターズムーン"
          }
        }
      }
    },
    "I couldn't reach the sky data just now — try again in a moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Himmelsdaten waren gerade nicht erreichbar — versuch es gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pude acceder a los datos del cielo ahora mismo — inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’accéder aux données du ciel pour l’instant — réessayez dans un moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non riesco a raggiungere i dati del cielo — riprova tra un attimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空のデータに接続できませんでした — 少ししてからもう一度お試しください。"
          }
        }
      }
    },
    "I just joined %@ — every plane, planet and star above me, labeled live in AR. 🛩️✨ Come look up with me.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin jetzt bei %@ — jedes Flugzeug, jeder Planet und jeder Stern über mir, live in AR beschriftet. 🛩️✨ Schau mit mir nach oben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acabo de unirme a %@ — cada avión, planeta y estrella sobre mí, etiquetados en vivo en RA. 🛩️✨ Ven a mirar el cielo conmigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je viens de rejoindre %@ — chaque avion, planète et étoile au-dessus de moi, annotés en direct en RA. 🛩️✨ Venez lever les yeux avec moi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho appena scoperto %@ — ogni aereo, pianeta e stella sopra di me, etichettati live in AR. 🛩️✨ Vieni a guardare il cielo con me."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を始めました — 頭上の飛行機も惑星も星も、ARでライブにラベル表示。🛩️✨ 一緒に空を見上げませんか。"
          }
        }
      }
    },
    "I'm a %@ in %@ — %lld flights spotted straight out of the sky above me. 🛩️✨ Think you can out-spot me?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin %1$@ in %2$@ — %3$lld Flüge direkt am Himmel über mir gesichtet. 🛩️✨ Meinst du, du toppst das?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "I'm a %1$@ in %2$@ — %3$lld flights spotted straight out of the sky above me. 🛩️✨ Think you can out-spot me?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soy %1$@ en %2$@ — %3$lld vuelos avistados directamente en el cielo sobre mí. 🛩️✨ ¿Crees que puedes superarme?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rang %1$@ dans %2$@ — %3$lld vols repérés directement dans le ciel au-dessus de moi. 🛩️✨ Vous pensez faire mieux ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono %1$@ su %2$@ — %3$lld voli avvistati direttamente nel cielo sopra di me. 🛩️✨ Pensi di riuscire a battermi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@で%1$@になりました — 頭上の空から%3$lld機を発見。🛩️✨ 私より見つけられますか？"
          }
        }
      }
    },
