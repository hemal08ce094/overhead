    "Earned %@" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conseguida %@"
          }
        }
      }
    },
    "Earth's shadow takes a dark bite out of the full moon. Perfectly safe to watch with bare eyes; binoculars make the shadow's edge crisp." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sombra de la Tierra le da un mordisco oscuro a la luna llena. Totalmente seguro a simple vista; unos binoculares hacen nítido el borde de la sombra."
          }
        }
      }
    },
    "Eclipses and conjunctions are computed for your exact location." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los eclipses y conjunciones se calculan para tu ubicación exacta."
