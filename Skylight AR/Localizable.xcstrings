    "Sweep a full circle, then lock onto the Sun, Moon, or a plane you can see — the most accurate way to line the sky up with reality.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreh dich einmal im Kreis und fixiere dann Sonne, Mond oder ein sichtbares Flugzeug — der genaueste Weg, den Himmel an der Wirklichkeit auszurichten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Barre un círculo completo y luego fija el Sol, la Luna o un avión que veas — la forma más precisa de alinear el cielo con la realidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez un cercle complet, puis verrouillez sur le Soleil, la Lune ou un avion visible — la façon la plus précise d’aligner le ciel sur la réalité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compi un giro completo, poi aggancia il Sole, la Luna o un aereo che vedi — il modo più preciso per allineare il cielo alla realtà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくり1周まわしてから、太陽・月・見えている飛行機のいずれかにロックしてください — 空を現実に合わせる最も正確な方法です。"
          }
        }
      }
    },
    "Sweep slowly in a full circle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreh dich langsam einmal im Kreis"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Barre despacio un círculo completo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez lentement un cercle complet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruota lentamente in un giro completo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくりと1周まわす"
          }
        }
      }
    },
    "Tail": {
      "localizations": {
        "de": {
