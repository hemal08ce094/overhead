    "A blood moon, from where you are": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Blutmond — von deinem Standort aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una luna de sangre, desde donde estás"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une lune de sang, depuis votre position"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una luna di sangue, da dove ti trovi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの場所から見るブラッドムーン"
          }
        }
      }
    },
    "A flight number reaches any aircraft in the world — type it as printed on your ticket.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Flugnummer findet jedes Flugzeug weltweit — gib sie so ein, wie sie auf deinem Ticket steht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un número de vuelo localiza cualquier avión del mundo — escríbelo tal como aparece en tu tarjeta de embarque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un numéro de vol atteint n’importe quel appareil au monde — saisissez-le tel qu’il figure sur votre billet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un numero di volo trova qualsiasi aereo nel mondo — scrivilo come appare sul biglietto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "便名なら世界中のどの航空機にも届きます — 航空券の表記どおりに入力してください。"
          }
        }
      }
    },
    "A flight you've favorited.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Flug, den du favorisiert hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vuelo que marcaste como favorito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vol que vous avez ajouté aux favoris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un volo tra i tuoi preferiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入りに登録したフライトです。"
          }
        }
      }
    },
    "A global match needs the full flight number — e.g. %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine weltweite Suche brauchst du die vollständige Flugnummer — z. B. %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una búsqueda global necesita el número de vuelo completo — p. ej. %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une recherche mondiale exige le numéro de vol complet — p. ex. %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per una ricerca globale serve il numero di volo completo — es. %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "世界検索には完全な便名が必要です — 例：%@。"
          }
        }
      }
    },
    "A global match needs the full tail — e.g. %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für eine weltweite Suche brauchst du das vollständige Kennzeichen — z. B. %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
