    "Landing now at %@%@. The filed route above is likely a different leg of this flight, or out of date.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Landet gerade in %1$@%2$@. Die oben angegebene Route ist vermutlich eine andere Etappe dieses Flugs oder veraltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Landing now at %1$@%2$@. The filed route above is likely a different leg of this flight, or out of date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aterrizando ahora en %1$@%2$@. La ruta declarada arriba probablemente sea otro tramo de este vuelo, o esté desactualizada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atterrit en ce moment à %1$@%2$@. La route déposée ci-dessus correspond sans doute à un autre tronçon de ce vol, ou n’est plus à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta atterrando ora a %1$@%2$@. La rotta registrata sopra è probabilmente un'altra tratta di questo volo, o non aggiornata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在%1$@%2$@に着陸中です。上に表示された登録ルートは、この便の別区間か、古い情報の可能性があります。"
          }
        }
      }
    },
