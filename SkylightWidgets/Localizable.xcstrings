    "How many aircraft are above you, and the nearest one on a live radar rose." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Flugzeuge über dir sind — und das nächste auf einer Live-Radarrose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuántos aviones hay sobre ti y el más cercano en una rosa de radar en vivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nombre d’avions au-dessus de vous, et le plus proche sur une rose radar en direct."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quanti aerei hai sopra la testa, e il più vicino su una rosa radar dal vivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頭上の航空機の数と、最も近い1機をライブのレーダー盤面に表示します。"
          }
        }
      }
    },
